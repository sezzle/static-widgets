{
    "name": "@sezzle/sezzle-static-widget",
    "version": "3.2.5",
    "description": "Simple SDK is a stand-alone widget script which helps merchants integrate widget onto their website.",
    "main": "src/awesomeSezzle.js",
    "files": [
        "src/",
        "css/",
        "dist/"
    ],
    "scripts": {
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "build": "npm run build-widget && npm run build-button && npm run build-banner",
        "build-button": "webpack --mode production --config webpack/shopify-checkout-button.config.js",
        "build-banner": "webpack --mode production --config webpack/sezzle-home-banner.config.js",
        "build-widget": "webpack --mode production --config webpack/webpack.config.js",
        "translate": "bun run translate:pull && bun run translate:push && echo \"\nPlease wait...\" && sleep 10 && bun run translate:pull",
        "translate:pull": "PROJECT_ID='9011409365ddb7b16ea8a5.04160017' bun run internals/scripts/pull_translations.mjs",
        "translate:push": "PROJECT_ID='9011409365ddb7b16ea8a5.04160017' bun run internals/scripts/push_translations.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://gitlab.sezzle.com/sezzle/static-widgets.git"
    },
    "author": "Sezzle",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "7.25.7",
        "@babel/preset-env": "^7.29.0",
        "babel-loader": "9.2.1",
        "clean-webpack-plugin": "4.0.0",
        "css-loader": "7.1.2",
        "file-loader": "6.2.0",
        "jsdom": "^25.0.1",
        "sass": "^1.99.0",
        "sass-loader": "16.0.2",
        "style-loader": "4.0.0",
        "webpack": "5.95.0",
        "webpack-cli": "5.1.4"
    },
    "keywords": [
        "price",
        "widget"
    ],
    "dependencies": {
        "@lokalise/node-api": "^15.2.1",
        "adm-zip": "^0.5.12",
        "chalk": "^5.6.2"
    },
    "overrides": {
        "baseline-browser-mapping": "2.10.23"
    }
}